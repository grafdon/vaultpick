#!/bin/sh
# shellcheck disable=SC2016 # jq programs and fzf commands are single-quoted on purpose
# vaultpick - pick a Bitwarden or Vaultwarden entry with fzf and copy what you need.
#
# Usage:
#   vaultpick [query]      copy the password
#   vaultpick -o [query]   copy the TOTP code
#   vaultpick -u [query]   copy the username
#   vaultpick -e [query]   edit the entry
#   vaultpick -s [query]   print the whole entry (including the password!)
#   vaultpick -c           check the setup and say how to fix what is missing
#   vaultpick -h           show this help
#   vaultpick -V           show the version
#
# Keys in the list:
#   enter    the action chosen above (default: copy the password)
#   ctrl-o   copy the TOTP code
#   ctrl-u   copy the username
#   ctrl-e   edit the entry
#   ctrl-s   print the whole entry
#   ctrl-t   switch to the next theme and remember it
#   esc      close
#
# Copying keeps the list open, so username, password and TOTP code can be
# fetched one after another without searching again. The status line says
# what was copied from which entry, never the value itself. Recently used
# entries are listed first; a query always searches the whole vault.
#
# Environment:
#   VAULTPICK_THEME        the theme until ctrl-t picks one: ansi (default), amber,
#                          mocha, latte, dracula, gruvbox, nord, onedark, rosepine,
#                          solarized, tokyonight; NO_COLOR turns colour off
#   VAULTPICK_RECENT       recent entries listed first (default 10, 0 = off)
#   VAULTPICK_CLEAR        seconds until the clipboard is cleared (default 45, 0 = never)
#   VAULTPICK_CLIPBOARD    auto (default), wayland, xclip, xsel, macos, termux, wsl, rbw
#   VAULTPICK_ASCII        1 = ASCII only, 0 = Unicode (default: from the locale)
#   VAULTPICK_PASS_LAYOUT  1 = a folder named like a domain is shown as the entry name
#
# Requires rbw 1.14 or newer, fzf 0.63 or newer, and jq.
set -eu

version=0.1.0

die() {
	printf 'vaultpick: %s\n' "$*" >&2
	exit 1
}
has() { command -v "$1" >/dev/null 2>&1; }

# Non-negative integer from $1, or the default $2. Leading zeros are dropped.
num() {
	case "$1" in
	'' | *[!0-9]*) printf '%s' "$2" ;;
	*) printf '%s' "$1" | sed 's/^0*\(.\)/\1/' ;;
	esac
}
recent_max=$(num "${VAULTPICK_RECENT:-}" 10)
clear_after=$(num "${VAULTPICK_CLEAR:-}" 45)

# --- Look -------------------------------------------------------------------

case "${VAULTPICK_ASCII:-}" in
1) ascii=1 ;;
0) ascii=0 ;;
*)
	case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
	*[Uu][Tt][Ff]-8* | *[Uu][Tt][Ff]8*) ascii=0 ;;
	*) ascii=1 ;;
	esac
	;;
esac
if [ "$ascii" = 1 ]; then
	g_recent='*' g_totp='*' g_link='>' g_ok='ok' g_err='x' g_dot='-' g_ell='~'
	pointer='>' prompt='> ' label=' vault '
else
	g_recent='↺' g_totp='●' g_link='↗' g_ok='✓' g_err='✗' g_dot='·' g_ell='…'
	pointer='▌' prompt='› ' label=' vault '
fi

esc=$(printf '\033')
sgr() { printf '%s[%sm' "$esc" "$1"; }
rgb() { sgr "38;2;$1"; }
on_rgb() { sgr "48;2;$1"; }

# The theme picked with ctrl-t is remembered and wins over VAULTPICK_THEME,
# which is the starting point until then.
themes='ansi amber mocha latte dracula gruvbox nord onedark rosepine solarized tokyonight'
theme_file="${XDG_CONFIG_HOME:-$HOME/.config}/vaultpick/theme"
theme=${VAULTPICK_THEME:-ansi}
theme_saved=0
if [ -f "$theme_file" ]; then
	read -r saved <"$theme_file" || :
	case "${saved:-}" in
	'' | *[!a-z]*) ;; # not a theme name: ignored
	*)
		case " $themes " in *" $saved "*) theme=$saved theme_saved=1 ;; esac
		;;
	esac
fi
[ -z "${NO_COLOR:-}" ] || theme=none

# The theme after $1 in the list, going round.
next_theme() {
	first='' previous=''
	for name in $themes; do
		[ -n "$first" ] || first=$name
		if [ "$previous" = "$1" ]; then
			printf '%s' "$name"
			return 0
		fi
		previous=$name
	done
	printf '%s' "$first"
}
c_reset=$(sgr 0)

# "r;g;b" from "rrggbb"
dec() {
	rest=${1#??} && red=${1%"$rest"}
	blue=${rest#??} && green=${rest%"$blue"}
	printf '%d;%d;%d' "0x$red" "0x$green" "0x$blue"
}
# A whole theme from ten colours: text, user, url, dim, ok, error, selected
# line, border, ghost, text on a chip.
palette() {
	c_name=$(rgb "$(dec "$1")")
	c_user=$(rgb "$(dec "$2")")
	c_url=$(rgb "$(dec "$3")")
	c_dim=$(rgb "$(dec "$4")")
	c_accent=$(rgb "$(dec "$5")")
	c_key="$(on_rgb "$(dec "$7")")$(rgb "$(dec "$2")")"
	c_chip_ok="$(sgr 1)$(on_rgb "$(dec "$5")")$(rgb "$(dec "${10}")")"
	c_chip_err="$(sgr 1)$(on_rgb "$(dec "$6")")$(rgb "$(dec "${10}")")"
	fzf_colors="bg:-1,bg+:#$7,fg:#$1,fg+:#$1,hl:#$3,hl+:#$3,prompt:#$2,pointer:#$2,marker:#$5,info:#$4,spinner:#$2,header:#$4,footer:#$4,border:#$8,label:#$3,query:#$1,separator:#$8,scrollbar:#$8,preview-border:#$8,preview-label:#$3,ghost:#$9,gutter:-1"
}

case "$theme" in
none)
	c_reset='' c_name='' c_user='' c_url='' c_dim='' c_accent=''
	c_key='' c_chip_ok='' c_chip_err=''
	fzf_colors='bw'
	;;
amber)
	c_name="$(sgr 1)$(rgb '255;255;255')"
	c_user=$(rgb '201;201;201')
	c_url=$(rgb '130;130;130')
	c_dim=$(rgb '105;105;105')
	c_accent=$(rgb '255;199;32')
	c_key="$(on_rgb '46;46;46')$(rgb '255;218;102')"
	c_chip_ok="$(sgr 1)$(on_rgb '255;199;32')$(rgb '20;20;20')"
	c_chip_err="$(sgr 1)$(on_rgb '239;68;68')$(rgb '255;255;255')"
	fzf_colors='bg:-1,bg+:#242424,fg:#b8b8b8,fg+:#ffffff:bold,hl:#ffc720,hl+:#ffda66:bold,prompt:#ffc720,pointer:#ffc720,marker:#ffc720,info:#696969,spinner:#ffc720,header:#828282,footer:#828282,border:#2e2e2e,label:#ffc720:bold,query:#ffffff,separator:#2e2e2e,scrollbar:#3b3b3b,preview-border:#2e2e2e,preview-label:#ffc720,ghost:#424242,gutter:-1'
	;;
# name: text, user, url, dim, ok, error, selected line, border, ghost, text on a chip
mocha) palette cdd6f4 cba6f7 fab387 7f849c a6e3a1 f38ba8 313244 45475a 585b70 11111b ;;
latte) palette 4c4f69 8839ef fe640b 8c8fa1 40a02b d20f39 ccd0da bcc0cc acb0be eff1f5 ;;
dracula) palette f8f8f2 bd93f9 8be9fd 6272a4 50fa7b ff5555 44475a 44475a 6272a4 282a36 ;;
gruvbox) palette ebdbb2 83a598 fabd2f 928374 b8bb26 fb4934 3c3836 504945 665c54 282828 ;;
nord) palette d8dee9 81a1c1 88c0d0 616e88 a3be8c bf616a 3b4252 434c5e 4c566a 2e3440 ;;
onedark) palette abb2bf c678dd 61afef 5c6370 98c379 e06c75 2c323c 3e4451 4b5263 282c34 ;;
rosepine) palette e0def4 c4a7e7 f6c177 6e6a86 9ccfd8 eb6f92 26233a 403d52 524f67 191724 ;;
solarized) palette 93a1a1 268bd2 2aa198 586e75 859900 dc322f 073642 586e75 586e75 002b36 ;;
tokyonight) palette c0caf5 bb9af7 7aa2f7 565f89 9ece6a f7768e 292e42 3b4261 414868 1a1b26 ;;
ansi)
	# The terminal's own 16 colours: works everywhere, light or dark.
	c_name=$(sgr 1)
	c_user=''
	c_url=$(sgr 36)
	c_dim=$(sgr 2)
	c_accent=$(sgr 33)
	c_key=$(sgr 7)
	c_chip_ok=$(sgr '1;30;42')
	c_chip_err=$(sgr '1;97;41')
	fzf_colors='16,hl:3,hl+:3:bold,prompt:3,pointer:3,marker:3,spinner:3,info:-1:dim,header:-1:dim,footer:-1,label:3:bold,preview-label:3,gutter:-1'
	;;
*) die "unknown theme '$theme' (available: $themes)" ;;
esac

# jq with the colours and glyphs every formatter needs
jqf() {
	jq -r --arg n "$c_name" --arg w "$c_user" --arg u "$c_url" --arg o "$c_dim" \
		--arg t "$c_accent" --arg a "$c_reset" --arg ell "$g_ell" \
		--arg dot "$g_totp" --arg link "$g_link" --arg rec "$g_recent" "$@"
}

# --- History ----------------------------------------------------------------

# Recently used entries, newest first. IDs only, never names.
history_file="${XDG_STATE_HOME:-$HOME/.local/state}/vaultpick/history"
remember() {
	[ "$recent_max" -gt 0 ] || return 0
	mkdir -p "${history_file%/*}" 2>/dev/null || return 0
	(
		umask 077
		{
			printf '%s\n' "$1"
			[ -f "$history_file" ] && grep -vxF -- "$1" "$history_file"
		} | head -n 100 >"$history_file.$$" && mv "$history_file.$$" "$history_file"
	) || :
}

# --- Clipboard --------------------------------------------------------------

clipboard_backend() {
	case "${VAULTPICK_CLIPBOARD:-auto}" in
	auto) ;;
	wayland | xclip | xsel | macos | termux | wsl | rbw)
		printf '%s' "$VAULTPICK_CLIPBOARD"
		return 0
		;;
	*) die "unknown VAULTPICK_CLIPBOARD '$VAULTPICK_CLIPBOARD'" ;;
	esac
	if [ -n "${WAYLAND_DISPLAY:-}" ] && has wl-copy; then
		printf wayland
	elif [ "$(uname -s)" = Darwin ] && has pbcopy; then
		printf macos
	elif [ -n "${TERMUX_VERSION:-}" ] && has termux-clipboard-set; then
		printf termux
	elif [ -n "${DISPLAY:-}" ] && has xclip; then
		printf xclip
	elif [ -n "${DISPLAY:-}" ] && has xsel; then
		printf xsel
	elif has clip.exe; then
		printf wsl
	else
		printf rbw
	fi
}

# Put $1 on the clipboard. Under Wayland the value is marked sensitive so that
# clipboard managers keep it out of their history (wl-clipboard 2.2 or newer).
sensitive=0
clip_set() {
	case "$backend" in
	wayland)
		sensitive=1
		printf '%s' "$1" | wl-copy --sensitive 2>/dev/null || {
			sensitive=0
			printf '%s' "$1" | wl-copy
		}
		;;
	macos) printf '%s' "$1" | pbcopy ;;
	termux) printf '%s' "$1" | termux-clipboard-set ;;
	xclip) printf '%s' "$1" | xclip -selection clipboard ;;
	xsel) printf '%s' "$1" | xsel --clipboard --input ;;
	wsl) printf '%s' "$1" | clip.exe ;;
	*) return 1 ;;
	esac >/dev/null 2>&1
}
clip_get() {
	case "$backend" in
	wayland) wl-paste -n ;;
	macos) pbpaste ;;
	termux) termux-clipboard-get ;;
	xclip) xclip -selection clipboard -o ;;
	xsel) xsel --clipboard --output ;;
	*) return 1 ;;
	esac 2>/dev/null
}
clip_clear() {
	case "$backend" in
	wayland) wl-copy --clear ;;
	macos) printf '' | pbcopy ;;
	termux) termux-clipboard-set '' ;;
	xclip) printf '' | xclip -selection clipboard ;;
	xsel) xsel --clipboard --clear ;;
	esac >/dev/null 2>&1
}

# Copy one field of an entry and print the new status line for fzf's footer.
# The value itself is never printed.
copy_action() {
	what=$1 id=$2
	case "$what" in
	password) value=$(rbw get "$id" 2>/dev/null) || value='' ;;
	totp) value=$(rbw code "$id" 2>/dev/null) || value='' ;;
	username) value=$(rbw get --field username "$id" 2>/dev/null) || value='' ;;
	*) die "unknown field '$what'" ;;
	esac
	chip=$(printf '%s' "$what" | tr '[:lower:]' '[:upper:]')
	if [ -z "$value" ] && ! rbw unlocked >/dev/null 2>&1; then
		printf '%s %s %s %s  %sthe vault is locked and was not unlocked%s' \
			"$c_chip_err" "$g_err" "$chip" "$c_reset" "$c_dim" "$c_reset"
		return 0
	fi
	if [ -z "$value" ]; then
		printf '%s %s %s %s  %sno %s in this entry%s' \
			"$c_chip_err" "$g_err" "$chip" "$c_reset" "$c_dim" "$what" "$c_reset"
		return 0
	fi

	backend=$(clipboard_backend)
	if [ "$backend" = rbw ]; then
		case "$what" in
		password) rbw get --clipboard "$id" ;;
		totp) rbw code --clipboard "$id" ;;
		username) rbw get --field username --clipboard "$id" ;;
		esac >/dev/null 2>&1 || backend=failed
		hint='via rbw, not cleared automatically'
	elif clip_set "$value"; then
		case "$backend:$clear_after" in
		*:0) hint='not cleared automatically' ;;
		wsl:*) hint='not cleared automatically' ;;
		*)
			(
				trap '' HUP
				sleep "$clear_after"
				[ "$(clip_get)" = "$value" ] && clip_clear
				:
			) </dev/null >/dev/null 2>&1 &
			hint="clears in $clear_after s"
			[ "$sensitive" = 0 ] || hint="$hint, kept out of clipboard history"
			;;
		esac
	else
		backend=failed
	fi
	if [ "$backend" = failed ]; then
		printf '%s %s %s %s  %scould not reach the clipboard%s' \
			"$c_chip_err" "$g_err" "$chip" "$c_reset" "$c_dim" "$c_reset"
		return 0
	fi

	remember "$id"
	who=$(rbw get --raw "$id" 2>/dev/null | jqf '
		def clean: gsub("[[:cntrl:]]"; " ");
		(.name // "" | clean) as $name | (.data.username // "" | clean) as $user
		| "\($n)\($name)\($a)" + (if $user != "" then "  \($w)\($user)\($a)" else "" end)') || who=''
	printf '%s %s %s %s  %s  %s%s %s %s %s%s' "$c_chip_ok" "$g_ok" "$chip" "$c_reset" \
		"$who" "$c_dim" "$g_dot" "$(date +%H:%M:%S)" "$g_dot" "$hint" "$c_reset"
}

# Preview pane: name, username, folder, TOTP yes/no and all URLs. No secrets.
# The preview runs on every move in the list, so it must never make rbw ask
# for the master password: with a locked vault that would be one prompt per
# move. Copying asks once and then refreshes the preview.
preview() {
	if ! rbw unlocked >/dev/null 2>&1; then
		printf '%sthe vault is locked %s copy something to unlock it%s\n' "$c_dim" "$g_dot" "$c_reset"
		return 0
	fi
	rbw get --raw "$1" | jqf '
		def clean: gsub("[[:cntrl:]]"; " ");
		(.name // "" | clean) as $name | (.data.username // "" | clean) as $user
		| (.folder // "" | clean) as $folder
		| "\($n)\($name)\($a)"
		  + (if $user != "" and $user != $name then "  \($w)\($user)\($a)" else "" end)
		  + (if $folder != "" then "  \($o)\($folder)\($a)" else "" end)
		  + (if .data.totp then "  \($t)\($dot) totp\($a)" else "" end),
		(if ((.data.uris // []) | length) > 0
			then (.data.uris[] | "\($t)\($link)\($a) \($u)\(.uri // "" | clean)\($a)")
			else "\($o)no url\($a)" end)'
}

# --- Setup ------------------------------------------------------------------

# fzf version as "major minor"; empty if it cannot be read
fzf_version() {
	fzf --version 2>/dev/null | sed -n '1s/^\([0-9][0-9]*\)\.\([0-9][0-9]*\).*/\1 \2/p'
}

# rbw version as "major minor"; empty if it cannot be read
rbw_version() {
	rbw --version 2>/dev/null | sed -n '1s/^rbw \([0-9][0-9]*\)\.\([0-9][0-9]*\).*/\1 \2/p'
}
rbw_install='https://github.com/doy/rbw#installation ("cargo install --locked rbw" works everywhere)'

rbw_setting() { rbw config show 2>/dev/null | jq -r --arg key "$1" '.[$key] // ""' 2>/dev/null; }

# Path of rbw's local cache for the configured account; fails if there is none.
rbw_cache_file() {
	email=$(rbw_setting email)
	server=$(rbw config show 2>/dev/null | jq -r '.base_url // "" | @uri' 2>/dev/null) || return 1
	suffix=${RBW_PROFILE:+-$RBW_PROFILE}
	for dir in "${XDG_CACHE_HOME:-$HOME/.cache}/rbw$suffix" "$HOME/Library/Caches/rbw$suffix"; do
		for file in "$dir/$server:$email.json" "$dir/default:$email.json"; do
			if [ -f "$file" ]; then
				printf '%s' "$file"
				return 0
			fi
		done
	done
	return 1
}

setup_hint='Set up rbw first:
  rbw config set email you@example.com
  rbw config set base_url https://vault.example.com   (only for Vaultwarden or self-hosted Bitwarden)
  rbw login
Then run "vaultpick --check".'

# vaultpick --check: go through everything vaultpick needs. Never asks for the
# master password and prints nothing about the account, so the output can be
# pasted into a bug report.
check() {
	problems=0
	say() { printf '%-5s %s\n' "$1" "$2"; }
	fix() { printf '      %s\n' "$1"; }
	bad() {
		say FAIL "$1"
		problems=1
	}
	printf 'vaultpick %s\n\n' "$version"

	found=$(rbw_version)
	rbw_usable=0
	if ! has rbw; then
		bad 'rbw not found'
		fix "install it: $rbw_install"
	elif [ -z "$found" ]; then
		bad 'could not read the rbw version'
	elif [ "${found% *}" -lt 1 ] || { [ "${found% *}" -eq 1 ] && [ "${found#* }" -lt 14 ]; }; then
		bad "rbw ${found% *}.${found#* } is too old, 1.14 or newer is needed"
		fix 'distribution packages are often old; get a current one:'
		fix "$rbw_install"
	else
		say ok "rbw ${found% *}.${found#* }"
		rbw_usable=1
		if [ "${found% *}" -eq 1 ] && [ "${found#* }" -lt 15 ]; then
			say warn 'rbw 1.15 or newer is needed for the URL column'
		fi
	fi
	if has jq; then
		say ok "$(jq --version 2>/dev/null | head -n 1)"
	else
		bad 'jq not found'
		fix 'install it: https://jqlang.org/download/'
	fi
	found=$(fzf_version)
	if ! has fzf; then
		bad 'fzf not found'
		fix 'install it: https://github.com/junegunn/fzf#installation'
	elif [ -z "$found" ]; then
		bad 'could not read the fzf version'
	elif [ "${found% *}" -eq 0 ] && [ "${found#* }" -lt 63 ]; then
		bad "fzf ${found% *}.${found#* } is too old, 0.63 or newer is needed"
		fix 'distribution packages are often old; get a current one:'
		fix 'https://github.com/junegunn/fzf#installation'
	else
		say ok "fzf ${found% *}.${found#* }"
	fi

	if [ "$rbw_usable" = 1 ] && has jq; then
		if [ -z "$(rbw_setting email)" ]; then
			bad 'rbw has no account yet'
			fix 'rbw config set email you@example.com'
			fix 'rbw config set base_url https://vault.example.com   (only for Vaultwarden or self-hosted Bitwarden)'
			fix 'rbw login'
		else
			say ok 'rbw account is configured'
			pinentry=$(rbw_setting pinentry)
			if has "${pinentry:-pinentry}"; then
				say ok "pinentry: ${pinentry:-pinentry}"
			else
				bad "pinentry program '${pinentry:-pinentry}' not found; rbw needs it to ask for the master password"
				fix 'macOS: brew install pinentry-mac && rbw config set pinentry pinentry-mac'
				fix 'Linux: install the pinentry package of your distribution'
			fi
			if rbw unlocked >/dev/null 2>&1; then
				say ok 'vault is unlocked'
			elif rbw_cache_file >/dev/null; then
				say ok 'logged in, vault is locked (rbw will ask for the master password)'
			else
				say warn 'vault is locked and no local rbw data was found'
				fix 'if you have not logged in yet: rbw login'
			fi
			if rbw_cache_file >/dev/null; then
				say ok 'TOTP markers: available'
			else
				say warn 'TOTP markers: rbw cache not found, entries with a TOTP code will not be marked'
			fi
		fi
	fi

	if backend=$(clipboard_backend 2>/dev/null); then
		if [ "$clear_after" -gt 0 ]; then cleared="cleared after $clear_after s"; else cleared='never cleared (VAULTPICK_CLEAR=0)'; fi
		case "$backend" in
		wayland) tool=wl-copy ;;
		macos) tool=pbcopy ;;
		termux) tool=termux-clipboard-set ;;
		wsl) tool=clip.exe ;;
		*) tool=$backend ;;
		esac
		if ! has "$tool"; then
			bad "clipboard: $tool not found (VAULTPICK_CLIPBOARD=$backend)"
		elif [ "$backend" = rbw ]; then
			say warn "clipboard: no clipboard tool found, rbw's own is used; not cleared automatically"
			fix 'install wl-clipboard (Wayland), or xclip or xsel (X11)'
		elif [ "$backend" = wsl ]; then
			say warn 'clipboard: clip.exe, not cleared automatically'
			fix 'with WSLg, install wl-clipboard to get clearing'
		elif [ "$backend" = wayland ] && wl-copy --help 2>&1 | grep -q -e --sensitive; then
			say ok "clipboard: wl-copy, $cleared, kept out of the clipboard history"
		elif [ "$backend" = wayland ]; then
			say ok "clipboard: wl-copy, $cleared"
			say warn 'wl-clipboard 2.2 or newer would also keep values out of the clipboard history'
		else
			say ok "clipboard: $tool, $cleared"
		fi
	else
		bad "clipboard: unknown VAULTPICK_CLIPBOARD '${VAULTPICK_CLIPBOARD:-}'"
		fix 'use auto, wayland, xclip, xsel, macos, termux, wsl or rbw'
	fi

	if [ "$ascii" = 1 ]; then glyphs=ASCII; else glyphs=Unicode; fi
	if [ "$theme_saved" = 1 ] && [ "$theme" != none ]; then picked=' (picked with ctrl-t)'; else picked=''; fi
	say ok "look: theme $theme$picked, $glyphs glyphs"

	printf '\n'
	if [ "$problems" -eq 0 ]; then
		printf 'Everything needed is in place.\n'
	else
		printf 'Fix the FAIL lines, then run "vaultpick --check" again.\n'
	fi
	return "$problems"
}

# --- Internal entry points, called by fzf -----------------------------------

case "${1:-}" in
__preview)
	preview "$2"
	exit 0
	;;
__copy)
	copy_action "$2" "$3"
	exit 0
	;;
__edit)
	remember "$2"
	exec rbw edit "$2"
	;;
__show)
	remember "$2"
	exec rbw get --full "$2"
	;;
__theme)
	# ctrl-t: save the next theme and start again with the same action and
	# query. fzf cannot change its colours while it runs.
	export _VAULTPICK_NOTE=theme
	{
		mkdir -p "${theme_file%/*}" && printf '%s\n' "$(next_theme "$theme")" >"$theme_file"
	} 2>/dev/null || export _VAULTPICK_NOTE=theme-failed
	shift
	case "${_VAULTPICK_ACTION:-}" in
	totp) set -- -o -- "$@" ;;
	username) set -- -u -- "$@" ;;
	edit) set -- -e -- "$@" ;;
	show) set -- -s -- "$@" ;;
	*) set -- -- "$@" ;;
	esac
	exec "$0" "$@"
	;;
-c | --check)
	check
	exit $?
	;;
-h | --help)
	sed -n '3,/^set -eu$/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'
	exit 0
	;;
-V | --version)
	printf 'vaultpick %s\n' "$version"
	exit 0
	;;
esac

# --- Main -------------------------------------------------------------------

action=password
case "${1:-}" in
-o) action=totp && shift ;;
-u) action=username && shift ;;
-e) action=edit && shift ;;
-s) action=show && shift ;;
--) ;;
-?*) die "unknown option '$1' (see vaultpick -h)" ;;
esac
[ "${1:-}" != -- ] || shift
query="$*"
export _VAULTPICK_ACTION="$action"

has rbw || die 'rbw not found, see https://github.com/doy/rbw'
has jq || die 'jq not found, see https://jqlang.org'
has fzf || die 'fzf not found, see https://github.com/junegunn/fzf'
rbw_found=$(rbw_version)
case "$rbw_found" in
'') die 'could not read the rbw version' ;;
0\ * | 1\ [0-9] | 1\ 1[0-3]) die "rbw 1.14 or newer is needed, found ${rbw_found% *}.${rbw_found#* }. Distribution packages are often old; see $rbw_install" ;;
esac
fzf_found=$(fzf_version)
fzf_major=${fzf_found% *} fzf_minor=${fzf_found#* }
case "$fzf_major$fzf_minor" in
'' | *[!0-9]*) die 'could not read the fzf version' ;;
esac
if [ "$fzf_major" -eq 0 ] && [ "$fzf_minor" -lt 63 ]; then
	die "fzf 0.63 or newer is needed, found 0.$fzf_minor. Distribution packages are often old; see https://github.com/junegunn/fzf#installation"
fi

case "$0" in
/*) self=$0 ;;
*) if [ -f "$0" ]; then self=$(pwd)/$0; else self=$(command -v -- "$0") || self=$0; fi ;;
esac
export _VAULTPICK_SELF="$self"

[ -n "$(rbw_setting email)" ] || die "rbw has no account yet.
$setup_hint"
rbw unlock || die 'could not unlock the vault. If you have not logged in yet, run "rbw login". "vaultpick --check" goes through the whole setup.'
entries=$(rbw list --raw) || die 'rbw list failed'

# Which entries have a TOTP secret? rbw list does not say, but rbw's local
# cache does: the secret is encrypted there, yet whether one exists is visible.
# Only IDs are read. Without the cache the marker is simply missing.
totp_ids() {
	file=$(rbw_cache_file) || return 0
	jq -r '.entries[]? | select((.data.Login.totp // null) != null) | .id' "$file" 2>/dev/null || :
}

# Column widths follow the terminal. Whatever does not fit is cut off on
# screen but can still be searched.
term_cols() {
	cols=$( (stty size </dev/tty | cut -d ' ' -f 2) 2>/dev/null) || cols=''
	case "$cols" in '' | *[!0-9]* | 0) cols=${COLUMNS:-} ;; esac
	case "$cols" in '' | *[!0-9]* | 0) cols=$(tput cols 2>/dev/null) || cols='' ;; esac
	case "$cols" in '' | *[!0-9]* | 0) cols=120 ;; esac
	printf '%s' "$cols"
}
flex=$(($(term_cols) - 22)) # frame, pointer, marker, 2FA column and gaps
if [ "$flex" -ge 96 ]; then
	w_name=26 w_user=30 w_url=26
else
	w_name=$((flex * 30 / 100)) w_user=$((flex * 32 / 100)) w_url=$((flex * 24 / 100))
	[ "$w_name" -ge 10 ] || w_name=10
	[ "$w_user" -ge 10 ] || w_user=10
	[ "$w_url" -ge 8 ] || w_url=8
fi

pass_layout=0
[ "${VAULTPICK_PASS_LAYOUT:-}" != 1 ] || pass_layout=1

# Lines: id <tab> marker name  user  2fa  url  folder
# Recently used entries first (newest on top), then the rest by folder and
# name. History IDs that no longer exist are skipped. Control characters in
# entry data are replaced, so a hostile name cannot draw on the terminal.
list() {
	printf '%s' "$entries" | jqf \
		--arg ids "$(totp_ids | tr '\n' ' ')" \
		--arg history "$(if [ -f "$history_file" ]; then tr '\n' ' ' <"$history_file"; fi)" \
		--argjson max "$recent_max" --argjson pass "$pass_layout" \
		--argjson wn "$w_name" --argjson ww "$w_user" --argjson wu "$w_url" '
	def clean: gsub("[[:cntrl:]]"; " ");
	def fit($b): (if length > $b then .[0:$b - 1] + $ell else . end) | . + (" " * ($b - length) // "");
	def host: sub("^[a-z][a-z0-9+.-]*://"; "") | sub("^www\\."; "") | sub("[/?#].*$"; "");
	($ids | split(" ") | map(select(. != "") | {(.): true}) | add // {}) as $totp
	| (map({(.id): true}) | add // {}) as $known
	| ($history | split(" ") | map(select($known[.])) | .[:$max]
		| to_entries | map({(.value): .key}) | add // {}) as $recent
	| sort_by(($recent[.id] // $max), (.folder // "" | ascii_downcase), (.name // "" | ascii_downcase))[]
	| (.folder // "" | clean) as $folder | (.name // "" | clean) as $name | (.user // "" | clean) as $user
	| ($folder | split("/")) as $parts | ($parts | last // "") as $last
	| (if $pass == 1 and ($last | test("\\.")) and ($last | test("@") | not)
		then {title: $last, path: ($parts[:-1] | join("/")), name: $name}
		else {title: $name, path: $folder, name: (if $name == $user then "" else $name end)} end) as $d
	| (if $user != "" and $user != $d.title then $user elif $d.name != $d.title then $d.name else "" end) as $who
	| (if $d.name != "" and $d.name != $user and $d.name != $d.title then " - " + $d.name else "" end) as $extra
	| ([.uris // [] | .[] | if type == "object" then .uri else . end
		| select(type == "string" and . != "") | clean]) as $uris
	| (if ($uris | length) == 0 then ""
		else ($uris[0] | host) + (if ($uris | length) > 1 then " +\(($uris | length) - 1)" else "" end) end) as $url
	| [.id,
		(if $recent[.id] != null then "\($t)\($rec)\($a) " else "  " end)
		+ "\($n)\($d.title | fit($wn))\($a)  \($w)\($who + $extra | fit($ww))\($a)  "
		+ (if $totp[.id] then "\($t)\($dot) totp\($a)" else "      " end)
		+ "  \($u)\($url | fit($wu))\($a)  \($o)\($d.path)\($a)"]
	| join("\t")'
}

key() { printf '%s %s %s %s' "$c_key" "$1" "$c_reset" "$2"; }
case "$action" in
totp) enter_label='totp' ;;
username) enter_label='username' ;;
edit) enter_label='edit' ;;
show) enter_label='show' ;;
*) enter_label='password' ;;
esac
keys="$(key enter "$enter_label")   $(key ^o totp)   $(key ^u username)   $(key ^e edit)   $(key ^s show)"
[ "$theme" = none ] || keys="$keys   $(key ^t theme)"
keys="$keys   $(key esc close)"
# shellcheck disable=SC2059 # the widths are part of the format
columns=$(printf "  %s%-${w_name}s  %-${w_user}s  %-6s  %-${w_url}s  %s%s" \
	"$c_dim" NAME USER 2FA URL FOLDER "$c_reset")
ready="${c_dim}copying keeps the list open ${g_dot} esc closes${c_reset}"
# Right after ctrl-t the status line names the new theme instead.
case "${_VAULTPICK_NOTE:-}" in
theme) ready="$c_chip_ok $g_ok THEME $c_reset  $c_name$theme$c_reset  ${c_dim}${g_dot} remembered ${g_dot} ctrl-t for the next${c_reset}" ;;
theme-failed) ready="$c_chip_err $g_err THEME $c_reset  ${c_dim}could not save the theme to $theme_file${c_reset}" ;;
esac
unset _VAULTPICK_NOTE

# fzf runs these through "sh -c" (see --with-shell), whatever the login shell.
copy() { printf 'transform-footer("$_VAULTPICK_SELF" __copy %s {1})+refresh-preview' "$1"; }
run() { printf 'become("$_VAULTPICK_SELF" __%s {1})' "$1"; }
case "$action" in
edit | show) on_enter=$(run "$action") ;;
*) on_enter=$(copy "$action") ;;
esac
binds="enter:$on_enter,double-click:$on_enter,ctrl-o:$(copy totp),ctrl-u:$(copy username),ctrl-e:$(run edit),ctrl-s:$(run show)"
# Without colour there is nothing to switch.
[ "$theme" = none ] || binds="$binds,ctrl-t:become(\"\$_VAULTPICK_SELF\" __theme {q})"

set -- --ansi --exact -i --tiebreak index --with-shell 'sh -c' \
	--delimiter '\t' --with-nth 2 \
	--layout reverse --height 75% --min-height 18 \
	--border rounded --border-label "$label" --border-label-pos 3 \
	--prompt "$prompt" --pointer "$pointer" \
	--info inline-right --ghost 'name, user, url, folder or totp' \
	--header "$keys

$columns" --header-border line \
	--color "$fzf_colors" \
	--preview '"$_VAULTPICK_SELF" __preview {1}' \
	--preview-window 'down,5,border-top,wrap' --preview-label ' details ' --preview-label-pos 3 \
	--footer "$ready" --footer-border line \
	--bind "$binds" \
	--query "$query"
[ "$ascii" = 0 ] || set -- "$@" --no-unicode
# The gutter became a visible character in fzf 0.66; keep it blank.
if [ "$fzf_major" -gt 0 ] || [ "$fzf_minor" -ge 66 ]; then
	set -- "$@" --gutter ' '
fi

status=0
list | fzf "$@" || status=$?
case "$status" in
1 | 130) exit 0 ;; # no match, or closed with esc
*) exit "$status" ;;
esac
